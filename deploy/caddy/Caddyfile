{
	email {$SHIPYARD_ACME_EMAIL:admin@example.com}
}

{$SHIPYARD_DOMAIN:localhost} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}
	handle /v2* {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}
	handle /auth/* {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}
	handle /repository/* {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}
	handle /healthz {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}
	handle /readyz {
		reverse_proxy {$SHIPYARD_UPSTREAM:shipyard-server:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
