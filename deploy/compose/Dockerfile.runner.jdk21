FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/shipyard-runner ./cmd/shipyard-runner

FROM eclipse-temurin:21-jdk-jammy
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates git curl && rm -rf /var/lib/apt/lists/*
COPY --from=moby/buildkit:v0.16.0 /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=build /out/shipyard-runner /usr/local/bin/shipyard-runner
ENTRYPOINT ["shipyard-runner"]
