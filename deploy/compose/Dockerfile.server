FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/shipyard-server ./cmd/shipyard-server
RUN mkdir -p /out/blobs

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/shipyard-server /app/shipyard-server
COPY migrations /app/migrations
COPY --from=build --chown=nonroot:nonroot /out/blobs /data/blobs
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/shipyard-server"]
