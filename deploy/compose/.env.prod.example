# Copy to .env on the VM and fill in. Never commit the real file.
SHIPYARD_DOMAIN=shipyard.example.com
SHIPYARD_ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=
# head -c 32 /dev/urandom | base64
SHIPYARD_SECRETS_KEY=
# Leave true only until the first account exists, then set false and redeploy.
SHIPYARD_ALLOW_REGISTER=true
# Only if something else already owns 80/443 on the host.
# SHIPYARD_HTTP_PORT=80
# SHIPYARD_HTTPS_PORT=443
