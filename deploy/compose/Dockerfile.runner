FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/shipyard-runner ./cmd/shipyard-runner

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/shipyard-runner /usr/local/bin/shipyard-runner
ENTRYPOINT ["shipyard-runner"]
