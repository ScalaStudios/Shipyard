SHIPYARD_HTTP_ADDR=:8080
SHIPYARD_DATABASE_URL=postgres://shipyard:shipyard@localhost:5432/shipyard?sslmode=disable
SHIPYARD_MIGRATIONS_DIR=migrations
SHIPYARD_STORAGE_BACKEND=filesystem
SHIPYARD_STORAGE_DIR=data/blobs
SHIPYARD_LOG_LEVEL=info
SHIPYARD_ALLOW_REGISTER=false
SHIPYARD_SESSION_TTL=168h
# Required to store pipeline secrets and forge/scm/discord credentials.
# Encrypts those tokens at rest; without it those writes are rejected.
# Generate with: head -c 32 /dev/urandom | base64
# SHIPYARD_SECRETS_KEY=
# SHIPYARD_WEBHOOK_SECRET=
# Public UI URL used in bot PR comments
# SHIPYARD_PUBLIC_URL=http://127.0.0.1:5173
# API origin used in runner install scripts (defaults to :8080)
# SHIPYARD_API_URL=http://127.0.0.1:8080
# Generic OIDC
# SHIPYARD_OIDC_ISSUER=
# SHIPYARD_OIDC_CLIENT_ID=
# SHIPYARD_OIDC_CLIENT_SECRET=
# SHIPYARD_OIDC_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/oidc/primary/callback
# Provider presets
# SHIPYARD_OIDC_GITHUB_CLIENT_ID=
# SHIPYARD_OIDC_GITHUB_CLIENT_SECRET=
# SHIPYARD_OIDC_GITLAB_CLIENT_ID=
# SHIPYARD_OIDC_GITLAB_CLIENT_SECRET=
# SHIPYARD_OIDC_GITLAB_ISSUER=https://gitlab.com
# SHIPYARD_OIDC_FORGEJO_CLIENT_ID=
# SHIPYARD_OIDC_FORGEJO_CLIENT_SECRET=
# SHIPYARD_OIDC_FORGEJO_ISSUER=https://git.lunarlabs.dev
# SHIPYARD_OIDC_GITEA_CLIENT_ID=
# SHIPYARD_OIDC_GITEA_CLIENT_SECRET=
# SHIPYARD_OIDC_GITEA_ISSUER=
# SHIPYARD_OIDC_ENTRA_CLIENT_ID=
# SHIPYARD_OIDC_ENTRA_CLIENT_SECRET=
# SHIPYARD_OIDC_ENTRA_TENANT=common
# SHIPYARD_OIDC_ENTRA_ISSUER=
# SHIPYARD_OIDC_ENTRA_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/oidc/entra/callback
# SHIPYARD_OIDC_DISCORD_CLIENT_ID=
# SHIPYARD_OIDC_DISCORD_CLIENT_SECRET=
# SHIPYARD_OIDC_DISCORD_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/oidc/discord/callback
# Forge API authorization for org import (separate from login OIDC above)
# Redirect URL to register on the forge: <api>/api/v1/forge/oauth/<provider>/callback
# SHIPYARD_FORGE_OAUTH_FORGEJO_CLIENT_ID=
# SHIPYARD_FORGE_OAUTH_FORGEJO_CLIENT_SECRET=
# SHIPYARD_FORGE_OAUTH_FORGEJO_ISSUER=https://git.lunarlabs.dev
# SHIPYARD_FORGE_OAUTH_FORGEJO_SCOPES=read:user read:organization write:repository
# SHIPYARD_FORGE_OAUTH_GITHUB_CLIENT_ID=
# SHIPYARD_FORGE_OAUTH_GITHUB_CLIENT_SECRET=
# SHIPYARD_FORGE_OAUTH_GITHUB_SCOPES=repo read:org admin:repo_hook
# SHIPYARD_FORGE_OAUTH_GITEA_CLIENT_ID=
# SHIPYARD_FORGE_OAUTH_GITEA_CLIENT_SECRET=
# SHIPYARD_FORGE_OAUTH_GITEA_ISSUER=
# SHIPYARD_S3_ENDPOINT=http://127.0.0.1:9000
# SHIPYARD_S3_BUCKET=shipyard
# SHIPYARD_S3_ACCESS_KEY=
# SHIPYARD_S3_SECRET_KEY=
